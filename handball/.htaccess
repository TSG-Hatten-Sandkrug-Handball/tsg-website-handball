# Apache configuration for /handball (requires mod_rewrite).
# This file overrides the parent TYPO3 rewrite rules inside /handball only.

Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /handball/404.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /handball/

    # Internal folders are never served.
    RewriteRule ^(includes|data)(/|$) - [F,L]

    # Old addresses of the previous handball pages (Lastenheft chapter 4).
    # Keep these permanent redirects for at least two years. QSD drops
    # TYPO3 parameters such as ?L=0.
    RewriteRule ^veranstaltungen/?$ termine/ [R=301,L,QSD]
    RewriteRule ^(tickets|hallenheft)/?$ heimspiele/ [R=301,L,QSD]
    RewriteRule ^abteilungsinfos/?$ abteilung/ [R=301,L,QSD]
    RewriteRule ^turnier/?$ kids-cup/ [R=301,L,QSD]
    RewriteRule ^trainer/?$ uebungsleiter/ [R=301,L,QSD]
    RewriteRule ^minis/?$ mannschaften/minis-sandkrug/ [R=301,L,QSD]
    RewriteRule ^f-jugend/?$ mannschaften/minis-kirchhatten/ [R=301,L,QSD]
    RewriteRule ^weibliche-d-jugend/?$ mannschaften/weibliche-d-jugend-1/ [R=301,L,QSD]
    RewriteRule ^(2-herren|damen|maennliche-[a-e]-jugend|weibliche-[b-e]-jugend(-[12])?)/?$ mannschaften/$1/ [R=301,L,QSD]

    # Clean URLs for articles and team pages.
    RewriteRule ^neuigkeiten/([a-z0-9-]+)/?$ neuigkeiten/article.php?slug=$1 [L,QSA]
    RewriteRule ^mannschaften/([a-z0-9-]+)/?$ mannschaften/team.php?slug=$1 [L,QSA]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
